{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Lobby",
  "version": "../package.json",
  "identifier": "app.gamelobby.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: http://lobby-cover.localhost lobby-cover: http://lobby-shot.localhost lobby-shot:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src https://cdn2.steamgriddb.com; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "A unified local game library and launcher",
    "license": "GPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzN0M2RDRFQzk4ODVGMDQKUldRRVg0akpUbTE4QTQ2a2FrM0F2eisyQkFnTXkzYXc5S1g4aEZ5R25tTUwxa2FoU25Ja1M5ci8K",
      "endpoints": ["https://github.com/m72b/GameLobby/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
