{
  "name": "game-lobby",
  "version": "0.9.0",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "A unified local game library and launcher",
  "homepage": "https://github.com/m72b/GameLobbies",
  "repository": { "type": "git", "url": "https://github.com/m72b/GameLobbies.git" },
  "bugs": { "url": "https://github.com/m72b/GameLobbies/issues" },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "node --test src/shared/*.test.mjs",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "build": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/quantico": "5.3.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.12.4",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "16.37.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^6.4.5"
  }
}
